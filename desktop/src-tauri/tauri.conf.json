{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Earmark",
  "version": "0.1.0",
  "identifier": "io.github.christian-ofigueiredo.earmark.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Earmark",
        "width": 1400,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 620,
        "center": true,
        "visible": false,
        "backgroundColor": "#131314"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; media-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "category": "Music",
    "shortDescription": "Finds the right sound in your sound-effect and music libraries",
    "copyright": "MIT License",
    "licenseFile": "../../LICENSE",
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
